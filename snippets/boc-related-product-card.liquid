{%- doc -%}
  Related product card for the boc-product-related section.
  Supports: second image on hover, gallery arrow navigation, quick-add cart overlay.

  @param {product} product - Shopify product
  @param {object} section - Parent section
{%- enddoc -%}

{%- liquid
  if product.has_only_default_variant
    assign variant = product.variants.first
  else
    assign variant = product.selected_or_first_available_variant
  endif

  capture boc_can_add_result
    render 'boc-variant-can-add', variant: variant
  endcapture
  assign variant_can_add = false
  if boc_can_add_result == 'true'
    assign variant_can_add = true
  endif

  assign vintage = product.metafields.wine.vintage
  assign wine_type = product.type
  assign meta_parts = ''
  if wine_type != blank
    assign meta_parts = wine_type
  endif
  if vintage != blank
    if meta_parts != blank
      assign meta_parts = meta_parts | append: ' · ' | append: vintage
    else
      assign meta_parts = vintage
    endif
  endif

  assign form_id = 'boc-related-form-' | append: section.id | append: '-' | append: product.id
  assign info_form_id = form_id | append: '-info'

  assign media_count = product.media.size
  assign show_gallery = false
  if media_count > 1
    assign show_gallery = true
  endif
-%}

<article
  class="related-card"
  data-boc-related-card
  data-media-count="{{ media_count }}"
>
  <div class="related-image" data-boc-related-gallery>
    <a href="{{ product.url }}" class="related-image__link">
      {%- if product.media.size > 0 -%}
        <img
          class="related-image__img related-image__img--primary"
          src="{{ product.media[0] | image_url: width: 800 }}"
          alt="{{ product.media[0].alt | default: product.title | escape }}"
          loading="lazy"
          width="400"
          height="400"
        >
      {%- else -%}
        <img
          class="related-image__img related-image__img--primary"
          src="{{ 'boc-placeholder-gruner-veltliner.jpg' | asset_url }}"
          alt="{{ product.title | escape }}"
          loading="lazy"
          width="400"
          height="400"
        >
      {%- endif -%}

      {%- if show_gallery and product.media[1] -%}
        <img
          class="related-image__img related-image__img--secondary"
          src="{{ product.media[1] | image_url: width: 800 }}"
          alt="{{ product.media[1].alt | default: product.title | escape }}"
          loading="lazy"
          width="400"
          height="400"
          aria-hidden="true"
        >
      {%- endif -%}
    </a>

    {%- if media_count > 2 -%}
      <button
        class="related-image__arrow related-image__arrow--prev"
        data-boc-gallery-prev
        aria-label="Previous image for {{ product.title | escape }}"
        type="button"
      >
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M12.5 15L7.5 10l5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <button
        class="related-image__arrow related-image__arrow--next"
        data-boc-gallery-next
        aria-label="Next image for {{ product.title | escape }}"
        type="button"
      >
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M7.5 5l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    {%- endif -%}

    {%- if product.has_only_default_variant and variant_can_add -%}
      <div class="related-image__quick-add" data-boc-quick-add>
        <product-form-component
          data-section-id="{{ section.id }}"
          data-product-id="{{ product.id }}"
          data-product-url="{{ product.url }}"
          on:submit="/handleSubmit"
          class="related-image__quick-add-form"
        >
          <div class="visually-hidden" aria-live="assertive" role="status" aria-atomic="true" ref="liveRegion"></div>
          {%- form 'product', product, id: form_id, data-type: 'add-to-cart-form' -%}
            <input type="hidden" name="id" ref="variantId" value="{{ variant.id }}">
            <input type="hidden" name="quantity" value="1">
            <button class="related-image__quick-add-btn" type="submit" aria-label="Add {{ product.title | escape }} to cart">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M5 8h14l-1 12H6L5 8Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                <path d="M9 8a3 3 0 0 1 6 0" stroke="currentColor" stroke-width="1.5"/>
                <line x1="12" y1="13" x2="12" y2="17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <line x1="10" y1="15" x2="14" y2="15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
              <span>Add</span>
            </button>
          {%- endform -%}
        </product-form-component>
      </div>
    {%- elsif not product.has_only_default_variant -%}
      <a href="{{ product.url }}" class="related-image__quick-add">
        <span class="related-image__quick-add-btn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M5 8h14l-1 12H6L5 8Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
            <path d="M9 8a3 3 0 0 1 6 0" stroke="currentColor" stroke-width="1.5"/>
          </svg>
          <span>Choose</span>
        </span>
      </a>
    {%- endif -%}

    {%- if media_count > 2 -%}
      <script type="application/json" data-boc-media-list>
        [
          {%- for media in product.media -%}
            {
              "src": {{ media | image_url: width: 800 | json }},
              "alt": {{ media.alt | default: product.title | json }}
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      </script>
    {%- endif -%}
  </div>

  <div class="related-info">
    <h3><a href="{{ product.url }}">{{ product.title }}</a></h3>
    {%- if meta_parts != blank -%}<p>{{ meta_parts }}</p>{%- endif -%}
    <strong>{% render 'format-price', price: variant.price %}</strong>

    {%- if product.has_only_default_variant and variant_can_add -%}
      <product-form-component
        data-section-id="{{ section.id }}"
        data-product-id="{{ product.id }}"
        data-product-url="{{ product.url }}"
        on:submit="/handleSubmit"
      >
        <div class="visually-hidden" aria-live="assertive" role="status" aria-atomic="true" ref="liveRegion"></div>
        {%- form 'product', product, id: info_form_id, data-type: 'add-to-cart-form' -%}
          <input type="hidden" name="id" ref="variantId" value="{{ variant.id }}">
          <input type="hidden" name="quantity" value="1">
          <button class="product-add" type="submit">Add to cart</button>
        {%- endform -%}
      </product-form-component>
    {%- elsif variant_can_add -%}
      <a href="{{ product.url }}" class="product-add">Choose options</a>
    {%- else -%}
      <button class="product-add" type="button" disabled>Sold out</button>
    {%- endif -%}
  </div>
</article>
