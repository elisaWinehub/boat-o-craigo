{%- liquid
  assign section_classes = 'boc-faq-section boc-faq-hero boc-faq-section--full'
  unless section.settings.section_enabled
    assign section_classes = section_classes | append: ' boc-faq-section--disabled'
  endunless
  unless section.settings.show_desktop
    assign section_classes = section_classes | append: ' boc-faq-section--hide-desktop'
  endunless
  unless section.settings.show_tablet
    assign section_classes = section_classes | append: ' boc-faq-section--hide-tablet'
  endunless
  unless section.settings.show_mobile
    assign section_classes = section_classes | append: ' boc-faq-section--hide-mobile'
  endunless
  assign image_fallback = 'boc-estate-visit.jpg' | asset_url
  assign align_desktop = section.settings.text_alignment_desktop | default: 'left'
-%}

{{ 'boc-faq.css' | asset_url | stylesheet_tag }}

<section
  id="boc-faq-hero-{{ section.id }}"
  class="{{ section_classes }}"
  data-boc-faq
  style="
    {%- render 'boc-page-hero-vars', section: section, prefix: 'fq' -%}
    --boc-fq-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --boc-fq-focal: {{ section.settings.image_focal_point }};
    --boc-fq-content-width: {{ section.settings.content_width }}px;
  "
>
  <div class="boc-faq-hero__media">
    {%- if section.settings.image != blank -%}
      {% render 'boc-responsive-image', image: section.settings.image, mobile_image: section.settings.mobile_image, alt: section.settings.heading, loading: 'eager', sizes: '100vw' %}
    {%- else -%}
      <img src="{{ image_fallback }}" alt="{{ section.settings.heading | escape }}" loading="eager" width="2400" height="650">
    {%- endif -%}
  </div>
  <div class="boc-faq-hero__overlay" aria-hidden="true"></div>
  <div class="boc-container boc-faq-hero__content boc-page-hero-align-{{ align_desktop }}">
    {%- if section.settings.eyebrow != blank -%}<span class="boc-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h1 class="boc-faq-section__heading">{{ section.settings.heading }}</h1>{%- endif -%}
    {%- if section.settings.body != blank -%}<p>{{ section.settings.body }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "BOC — FAQ Hero",
  "tag": "section",
  "class": "boc-faq-hero-section",
  "settings": [
    { "type": "checkbox", "id": "section_enabled", "label": "Enable section", "default": true },
    { "type": "checkbox", "id": "show_desktop", "label": "Show on desktop", "default": true },
    { "type": "checkbox", "id": "show_tablet", "label": "Show on tablet", "default": true },
    { "type": "checkbox", "id": "show_mobile", "label": "Show on mobile", "default": true },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 55 },
    { "type": "range", "id": "height_desktop", "label": "Desktop height", "min": 420, "max": 900, "step": 20, "unit": "px", "default": 560 },
    { "type": "range", "id": "height_tablet", "label": "Tablet height", "min": 360, "max": 760, "step": 20, "unit": "px", "default": 520 },
    { "type": "range", "id": "height_mobile", "label": "Mobile height", "min": 320, "max": 640, "step": 20, "unit": "px", "default": 460 },
    { "type": "select", "id": "image_focal_point", "label": "Image focal point", "options": [{"value":"center","label":"Center"},{"value":"top","label":"Top"},{"value":"bottom","label":"Bottom"}],"default": "center" },
    { "type": "range", "id": "content_width", "label": "Content max width", "min": 480, "max": 960, "step": 20, "unit": "px", "default": 760 },
    { "type": "select", "id": "text_alignment_desktop", "label": "Desktop text alignment", "options": [{"value":"left","label":"Left"},{"value":"center","label":"Center"}],"default": "left" },
    { "type": "select", "id": "text_alignment_mobile", "label": "Mobile text alignment", "options": [{"value":"left","label":"Left"},{"value":"center","label":"Center"}],"default": "left" },
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile background image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Help centre" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently asked questions" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Find answers about cellar door visits, our wines, orders and more." }
  ],
  "presets": [{ "name": "BOC — FAQ Hero" }]
}
{% endschema %}
